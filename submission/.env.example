# This release is frozen to local BGE embeddings and Ollama.
TEST_MODE=false
ALLOW_CATALOG_EMBEDDING=false

# Optional: DeepSeek parses state updates and intent when a key is set;
# every failure falls back to Ollama per call. Leave empty for fully local.
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=3

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30
CONFIDENCE_SIMILARITY_THRESHOLD=0.40

# Optional path overrides. Relative paths are resolved from the launch directory.
TECHJAM_CATALOG_PATH=
TECHJAM_BGE_CACHE_DIR=
