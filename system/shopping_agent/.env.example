# false/unset = local BGE + Ollama; true = OpenAI embeddings + Responses API.
TEST_MODE=false

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TIMEOUT_SECONDS=30

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30

# Normal startup never creates a missing catalogue cache.
ALLOW_CATALOG_EMBEDDING=false

# Inclusive current-query cosine gate applied to the fixed post-ranking top 10.
CONFIDENCE_SIMILARITY_THRESHOLD=0.40
